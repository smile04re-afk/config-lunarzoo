local function SetupFloatingToggleButton(targetWindow)
    if CoreGui:FindFirstChild("Lunar_ToggleButtonGui") then
        pcall(function() CoreGui.Lunar_ToggleButtonGui:Destroy() end)
    end
    
    local ToggleGui = Instance.new("ScreenGui")
    ToggleGui.Name = "Lunar_ToggleButtonGui"
    ToggleGui.ResetOnSpawn = false
    ToggleGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    
    local Container = Instance.new("Frame")
    Container.Name = "DragContainer"
    Container.Size = UDim2.fromOffset(62, 62)
    Container.Position = UDim2.new(0, 25, 0.45, 0)
    Container.BackgroundTransparency = 1
    Container.Parent = ToggleGui
    
    local Button = Instance.new("ImageButton")
    Button.Name = "PopupButton"
    Button.Size = UDim2.fromScale(1, 1)
    Button.Position = UDim2.fromScale(0, 0)
    Button.BackgroundColor3 = Color3.fromRGB(15, 20, 32)
    Button.BackgroundTransparency = 0.1
    Button.AutoButtonColor = false
    Button.Active = true
    Button.ClipsDescendants = true
    Button.Parent = Container
    
    local UICorner = Instance.new("UICorner")
    UICorner.CornerRadius = UDim.new(0, 31)
    UICorner.Parent = Button
    
    local UIStroke = Instance.new("UIStroke")
    UIStroke.Name = "BorderStroke"
    UIStroke.Color = Color3.fromRGB(90, 180, 255)
    UIStroke.Thickness = 2.5
    UIStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    UIStroke.Parent = Button
    
    -- Logo Image
    local Logo = Instance.new("ImageLabel")
    Logo.Name = "LogoImage"
    Logo.Size = UDim2.fromScale(1, 1)
    Logo.Position = UDim2.fromScale(0, 0)
    Logo.BackgroundTransparency = 1
    Logo.ScaleType = Enum.ScaleType.Fit
    
    -- Load user's uploaded mascot picture (Roblox Asset ID)
    Logo.Image = "rbxassetid://119039380747392"
    Logo.Parent = Button
    
    -- Status Dot (Green = UI Visible, Red = UI Hidden)
    local StatusDot = Instance.new("Frame")
    StatusDot.Name = "StatusDot"
    StatusDot.Size = UDim2.fromOffset(14, 14)
    StatusDot.Position = UDim2.new(1, -15, 1, -15)
    StatusDot.BackgroundColor3 = Color3.fromRGB(50, 230, 100)
    StatusDot.ZIndex = 5
    StatusDot.Parent = Container
    
    local DotCorner = Instance.new("UICorner")
    DotCorner.CornerRadius = UDim.new(1, 0)
    DotCorner.Parent = StatusDot
    
    local DotStroke = Instance.new("UIStroke")
    DotStroke.Thickness = 1.8
    DotStroke.Color = Color3.fromRGB(15, 20, 32)
    DotStroke.Parent = StatusDot
    
    local function UpdateVisualState(visible)
        if visible then
            StatusDot.BackgroundColor3 = Color3.fromRGB(50, 230, 100)
            UIStroke.Color = Color3.fromRGB(90, 180, 255)
        else
            StatusDot.BackgroundColor3 = Color3.fromRGB(240, 70, 70)
            UIStroke.Color = Color3.fromRGB(110, 120, 140)
        end
    end
    
    if targetWindow and targetWindow.Root then
        targetWindow.Root:GetPropertyChangedSignal("Visible"):Connect(function()
            UpdateVisualState(targetWindow.Root.Visible)
        end)
    end
    
    -- Dragging Logic
    local dragging = false
    local dragStart = nil
    local startPos = nil
    local isMoving = false
    
    Button.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            isMoving = false
            dragStart = input.Position
            startPos = Container.Position
            
            local connection
            connection = input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                    connection:Disconnect()
                end
            end)
        end
    end)
    
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - dragStart
            if delta.Magnitude > 4 then
                isMoving = true
            end
            
            local viewport = Workspace.CurrentCamera and Workspace.CurrentCamera.ViewportSize or Vector2.new(1920, 1080)
            local newX = math.clamp(startPos.X.Offset + delta.X, 0, viewport.X - 70)
            local newY = math.clamp(startPos.Y.Offset + delta.Y, 0, viewport.Y - 70)
            
            Container.Position = UDim2.new(
                startPos.X.Scale,
                newX,
                startPos.Y.Scale,
                newY
            )
        end
    end)
    
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    
    -- Toggle Action
    local function ToggleUI()
        if not targetWindow or not targetWindow.Root then return end
        local isVisible = targetWindow.Root.Visible
        local willVisible = not isVisible
        
        TweenService:Create(Button, TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Size = UDim2.fromOffset(54, 54),
            Position = UDim2.fromOffset(4, 4)
        }):Play()
        task.wait(0.08)
        TweenService:Create(Button, TweenInfo.new(0.12, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Size = UDim2.fromScale(1, 1),
            Position = UDim2.fromScale(0, 0)
        }):Play()
        
        targetWindow.Root.Visible = willVisible
        UpdateVisualState(willVisible)
    end
    
    Button.MouseButton1Click:Connect(function()
        if not isMoving then
            ToggleUI()
        end
    end)
    
    ToggleGui.Parent = CoreGui
    return ToggleGui
end

----------------------------------------------------------------------
-- HELPER FUNCTIONS
----------------------------------------------------------------------

local function GetCharacter()
    return LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
end

local function GetRootPart()
    local char = GetCharacter()
    return char:FindFirstChild("HumanoidRootPart")
end

local function GetHumanoid()
    local char = GetCharacter()
    return char:FindFirstChildOfClass("Humanoid")
end

local function GetMyPlot()
    for _, plot in ipairs(Workspace.Plots:GetChildren()) do
        if plot:GetAttribute("NestsOwnerLoaded") == LocalPlayer.UserId 
           or (plot:FindFirstChild("Data") and plot.Data:GetAttribute("Owner") == LocalPlayer.UserId) then
            return plot
        end
    end
    return nil
end

local function TeleportTo(cf)
    local root = GetRootPart()
    if root then
        if typeof(cf) == "Vector3" then
            root.CFrame = CFrame.new(cf + Vector3.new(0, 3, 0))
        elseif typeof(cf) == "CFrame" then
            root.CFrame = cf + Vector3.new(0, 3, 0)
        end
    end
end

-- Get unique egg types for dropdown
local function GetActiveEggTypes()
    local types = { "All" }
    local seen = {}
    if ActiveEggsFolder then
        for _, egg in ipairs(ActiveEggsFolder:GetChildren()) do
            local eggType = egg:GetAttribute("Egg")
            if eggType and not seen[eggType] then
                seen[eggType] = true
                table.insert(types, eggType)
            end
        end
    end
    table.sort(types)
    return types
end

